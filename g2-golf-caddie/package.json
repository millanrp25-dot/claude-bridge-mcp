{
  "name": "g2-golf-caddie",
  "version": "0.1.0",
  "description": "GPS golf caddie for Even Realities G2 smart glasses — yardages, shot tracking, scorecard and club suggestions on the heads-up display",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
